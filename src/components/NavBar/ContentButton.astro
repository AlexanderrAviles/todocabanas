<span class="absolute -inset-0.5"></span>
<span class="sr-only">Toggle menú</span>

<!-- Ícono para menú cerrado (hamburguesa) -->
<svg
  class="menu-closed block w-6 h-6"
  fill="none"
  viewBox="0 0 24 24"
  stroke-width="1.5"
  stroke="currentColor"
>
  <path
    stroke-linecap="round"
    stroke-linejoin="round"
    d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"></path>
</svg>

<!-- Ícono para menú abierto (X) -->
<svg
  class="menu-open hidden w-6 h-6"
  fill="none"
  viewBox="0 0 24 24"
  stroke-width="1.5"
  stroke="currentColor"
>
  <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"
  ></path>
</svg>
