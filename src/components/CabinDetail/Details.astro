---
type Details = Record<string, string>;
const { details } = Astro.props as { details: Details };
const entries = Object.entries(details);
const initialDisplayCount = 6;
---

<div id="details-root" class="mt-10">
  <h2 class="text-3xl font-bold text-primary mb-6 text-center">
    Características de la cabaña
  </h2>

  <div
    id="details-grid"
    class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6"
  >
    {entries.map(([key, value], index) => (
      <div
        data-index={index}
        class={
          `group bg-white rounded-xl shadow-sm p-5 flex gap-4 items-start hover:shadow-md transition-all duration-300 border border-gray-100` +
          (index >= initialDisplayCount ? " hidden" : "")
        }
      >
        <!-- Ícono de check -->
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="text-primary mt-1 flex-shrink-0"
          width="24"
          height="24"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="12" cy="12" r="9" />
          <path d="M9 12l2 2l4-4" />
        </svg>
        <div>
          <p class="text-primary font-semibold text-lg">{key}</p>
          <p class="text-t-secondary text-sm mt-1">{value}</p>
        </div>
      </div>
    ))}
  </div>

  {entries.length > initialDisplayCount && (
    <div class="text-center mt-6">
      <button
        id="details-toggle-button"
        class="!bg-primary !text-secondary px-4 py-2 rounded-md hover:!bg-primary-hover transition-all duration-300"
      >
        Ver más
      </button>
    </div>
  )}
</div>

<script is:inline>
(() => {
  const root = document.getElementById("details-root");
  if (!root) return;
  const items = Array.from(root.querySelectorAll<HTMLElement>('#details-grid [data-index]'));
  const toggleBtn = root.querySelector<HTMLButtonElement>('#details-toggle-button');
  if (!toggleBtn) return;

  let showAll = false;
  const initialCount = " + initialDisplayCount + ";

  toggleBtn.addEventListener("click", () => {
    showAll = !showAll;
    items.forEach((item) => {
      const idx = Number(item.dataset.index);
      if (idx >= initialCount) {
        if (showAll) {
          item.classList.remove("hidden");
          item.classList.add("animate-fade-in");
        } else {
          item.classList.add("hidden");
          item.classList.remove("animate-fade-in");
        }
      }
    });
    toggleBtn.textContent = showAll ? "Ver menos" : "Ver más";
  });
})();
</script>
