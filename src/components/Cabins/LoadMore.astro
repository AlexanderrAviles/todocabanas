---
// LoadMore.astro
// Recibe el offset que devuelve Airtable y genera un enlace de paginación.
const { offset } = Astro.props as { offset?: string };
---
{offset && (
  <div class="text-center mt-6">
    <a
      href={`?offset=${offset}`}
      class="!bg-primary !text-secondary px-4 py-2 rounded-md hover:!bg-primary-hover transition-all duration-300 inline-block"
    >
      Cargar más
    </a>
  </div>
)}
