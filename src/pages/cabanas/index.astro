---
import Layout from "../../layouts/Layout.astro";
import Card from "../../components/Cabins/Card.astro";
import { getCabins } from "../../services/fecthCabin";
import type { Cabin } from "../../types/Cabin";

const pageSize = 12;

const pageParam = parseInt(Astro.url.searchParams.get("page") ?? "1", 10);

let offsetParam: string | undefined = undefined;
let pageCabins: Cabin[] = [];

for (let p = 1; p <= pageParam; p++) {
  const { cabins, offset } = await getCabins(pageSize, offsetParam);
  pageCabins = cabins;
  offsetParam = offset;
  if (!offsetParam) break;
}

const hasPrev = pageParam > 1;
const hasNext = Boolean(offsetParam);
---

<Layout>
  <div class="container px-4 mx-auto py-10">
    <h1 class="text-5xl font-bold text-primary mb-8 text-center">
      Todas las Cabañas
    </h1>

    {
      pageCabins.length === 0 ? (
        <p class="text-center text-primary">No se encontraron cabañas.</p>
      ) : (
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-6">
          {pageCabins.map((cabin) => (
            <Card cabin={cabin} />
          ))}
        </div>
      )
    }

    <nav class="flex justify-between mt-8">
      {
        hasPrev ? (
          <a
            href={`/todocabanas/cabanas?page=${pageParam - 1}`}
            class="!bg-primary !text-secondary px-4 py-2 rounded-md hover:!bg-primary-hover transition-all duration-300"
          >
            ← Anterior
          </a>
        ) : (
          <span />
        )
      }

      {
        hasNext && (
          <a
            href={`/todocabanas/cabanas?page=${pageParam + 1}`}
            class="!bg-primary !text-secondary px-4 py-2 rounded-md hover:!bg-primary-hover transition-all duration-300"
          >
            Siguiente →
          </a>
        )
      }
    </nav>
  </div>
</Layout>
